# 飞书(Feishu/Lark) API 配置
# 在飞书开放平台创建企业自建应用获取

# 应用凭证（飞书开放平台 → 应用详情 → 凭证与基础信息）
NEXT_PUBLIC_FEISHU_APP_ID=cli_xxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxx

# 多维表格 ID（从飞书多维表格 URL 中获取）
# 例如：https://feishu.cn/base/xxxxxxxxxx
NEXT_PUBLIC_FEISHU_BASE_ID=xxxxxxxxxx

# 表格 ID（飞书多维表格中右键表格 → 复制链接 → 提取 tableId）
NEXT_PUBLIC_FEISHU_TABLE_ID=tblxxxxxxxx

# ─────────────────────────────────────────────────────────────
# 员工后台（服务端）
# ─────────────────────────────────────────────────────────────
# 员工后台密码。**只放服务端**（Cloudflare Pages → Settings → Environment
# variables → 设为 Secret），不要用 NEXT_PUBLIC_ 前缀，否则会打进前端 bundle。
# 未设置时后端会回退到 NEXT_PUBLIC_STAFF_PASSWORD（仅为兼容旧部署）。
STAFF_PASSWORD=change-me

# 签发员工会话 token 的 HMAC 密钥。**只放服务端**。
# 不设置时回退到 FEISHU_APP_SECRET（保证开箱即用，但建议独立设置）。
STAFF_TOKEN_SECRET=change-me-too

# 前端登录界面用的密码（会打进 bundle，仅用于输入框提示/兼容回退）
NEXT_PUBLIC_STAFF_PASSWORD=change-me

# 站点正式地址（状态链接用）
NEXT_PUBLIC_APP_URL=https://jiangangchong-app.pages.dev
